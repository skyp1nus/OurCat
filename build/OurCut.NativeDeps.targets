<Project>
  <!--
    Copies the native binaries downloaded by scripts/fetch-deps.ps1 (ffmpeg, ffprobe, libmpv)
    from deps/<rid>/ into the app's output and publish folders.
    Missing binaries only produce a warning, so Core, Media and the tests still build without them.
  -->
  <PropertyGroup>
    <_OurCutOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</_OurCutOs>
    <_OurCutOs Condition="'$(_OurCutOs)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx</_OurCutOs>
    <_OurCutOs Condition="'$(_OurCutOs)' == ''">linux</_OurCutOs>
    <_OurCutArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_OurCutArch>
    <OurCutNativeRid Condition="'$(OurCutNativeRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</OurCutNativeRid>
    <OurCutNativeRid Condition="'$(OurCutNativeRid)' == ''">$(_OurCutOs)-$(_OurCutArch)</OurCutNativeRid>
    <OurCutNativeDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'deps', '$(OurCutNativeRid)'))</OurCutNativeDir>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(OurCutNativeDir)')">
    <None Include="$(OurCutNativeDir)**\*"
          Exclude="$(OurCutNativeDir).ourcut-deps.json"
          Link="%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true"
          Visible="false" />
  </ItemGroup>

  <Target Name="OurCutCheckNativeDeps"
          BeforeTargets="Build"
          Condition="$(OurCutNativeRid.StartsWith('win-')) and !Exists('$(OurCutNativeDir).ourcut-deps.json')">
    <Warning Code="OURCUT001"
             Text="Native dependencies for $(OurCutNativeRid) are missing. Run: pwsh scripts/fetch-deps.ps1 -Rid $(OurCutNativeRid)" />
  </Target>
</Project>
