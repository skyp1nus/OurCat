<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup Label="Media">
    <PackageVersion Include="FFMpegCore" Version="5.5.0" />
    <!-- Keep SkiaSharp on the version Avalonia.Skia 12.1 is built and tested against. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup Label="MCP">
    <!-- The official MCP C# SDK, core package only (no ASP.NET or hosting). -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup Label="Transcription">
    <!-- bzip2 for the sherpa-onnx model archives (.tar.bz2); .NET has no bzip2 decoder. -->
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <!-- Speech recognition (Parakeet, Whisper) on ONNX Runtime; Apache-2.0. Pulls the native runtime per platform. -->
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <!-- Avalonia.Headless.XUnit 12.1 requires xUnit v3 3.x; 4.x breaks test discovery. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
  </ItemGroup>
</Project>
