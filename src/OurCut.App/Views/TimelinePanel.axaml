<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OurCut.App.ViewModels"
             xmlns:c="using:OurCut.App.Controls"
             x:Class="OurCut.App.Views.TimelinePanel"
             x:DataType="vm:EditorViewModel">
  <Border Name="Root" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
          Classes.disabled="{Binding IsEmpty}">
    <Grid RowDefinitions="36,174">
      <!-- Toolbar -->
      <Grid Margin="14,0,12,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Source" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="mono" Text="{Binding SourceLengthText}" FontSize="11" Foreground="{StaticResource Muted2Brush}"
                     VerticalAlignment="Center" Margin="0,1,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="18,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Kept" FontSize="11.5" Foreground="{StaticResource Text4Brush}" VerticalAlignment="Center" />
            <TextBlock Classes="mono" Text="{Binding KeptText}" FontSize="11.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Width="10" Height="10" CornerRadius="2" BorderBrush="{StaticResource Muted3Brush}" BorderThickness="1"
                    VerticalAlignment="Center" ClipToBounds="True">
              <c:HatchFill Period="3" Stroke="{StaticResource Muted3Brush}" />
            </Border>
            <TextBlock Text="Excluded" FontSize="11.5" Foreground="{StaticResource Text4Brush}" VerticalAlignment="Center" />
            <TextBlock Classes="mono" Text="{Binding ExcludedText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="ghost" Width="20" Height="20" FontSize="14" Foreground="{StaticResource Text4Brush}" ToolTip.Tip="Zoom out"
                  Command="{Binding ZoomOutCommand}" Content="−" />
          <Slider Theme="{StaticResource ZoomSlider}" Width="96" Minimum="0" Maximum="1" Value="{Binding ZoomLevel}" VerticalAlignment="Center" />
          <Button Classes="ghost" Width="20" Height="20" FontSize="14" Foreground="{StaticResource Text4Brush}" ToolTip.Tip="Zoom in"
                  Command="{Binding ZoomInCommand}" Content="+" />
        </StackPanel>
        <Border Grid.Column="4" Width="1" Height="16" Background="{StaticResource OutlineBrush}" Margin="18,0,0,0" />
        <Button Grid.Column="5" Classes="outline" Height="24" Padding="8,0,6,0" FontSize="11" Margin="18,0,0,0"
                ToolTip.Tip="Split at playhead (S)" Command="{Binding SplitCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Split" VerticalAlignment="Center" />
            <Border Classes="kbd plain small"><TextBlock Text="S" /></Border>
          </StackPanel>
        </Button>
        <Button Grid.Column="6" Classes="outline" Height="24" Padding="8,0,6,0" FontSize="11" Margin="18,0,0,0"
                ToolTip.Tip="Exclude or keep the selected part (E)" Command="{Binding ToggleExcludeCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding ExcludeLabel}" VerticalAlignment="Center" />
            <Border Classes="kbd plain small"><TextBlock Text="E" /></Border>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Lanes -->
      <Grid Grid.Row="1" ColumnDefinitions="112,*" Margin="0,0,12,0">
        <StackPanel Margin="8,30,6,0" Spacing="2">
          <Border Classes="lane" Height="52">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="mono lane-name" Text="V1" />
              <TextBlock Classes="lane-sub" Text="Video" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding AudioLanes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AudioLaneViewModel">
                <Border Classes="lane" Height="24" Classes.muted="{Binding IsMuted}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Classes="mono lane-name" Text="{Binding Key}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="lane-sub" Text="{Binding Label}" Margin="6,0" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="mute" Width="20" Height="20" ToolTip.Tip="{Binding MuteTip}"
                            Command="{Binding ToggleMuteCommand}">
                      <Panel>
                        <c:SvgIcon Data="{StaticResource IconTrackOn}" ViewBox="16" StrokeWidth="1.3" Width="13" Height="13"
                                   IsVisible="{Binding !IsMuted}" />
                        <c:SvgIcon Data="{StaticResource IconTrackMuted}" ViewBox="16" StrokeWidth="1.3" Width="13" Height="13"
                                   IsVisible="{Binding IsMuted}" />
                      </Panel>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Panel Grid.Column="1">
          <c:TimelineControl Name="Timeline" Height="164" VerticalAlignment="Top" Editor="{Binding}" />
          <ScrollBar Name="HScroll" Orientation="Horizontal" VerticalAlignment="Bottom" Height="8" Margin="0,0,0,1"
                     Minimum="0" Maximum="{Binding #Timeline.MaxScroll}" ViewportSize="{Binding #Timeline.Bounds.Width}"
                     Value="{Binding #Timeline.ScrollOffset, Mode=TwoWay}"
                     IsVisible="{Binding #Timeline.MaxScroll, Converter={x:Static c:Converters.IsPositive}}" />
        </Panel>
      </Grid>
    </Grid>
  </Border>

  <UserControl.Styles>
    <Style Selector="Border#Root.disabled">
      <Setter Property="Opacity" Value="0.35" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.lane">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#232323" />
      <Setter Property="Padding" Value="8,0,2,0" />
    </Style>
    <Style Selector="TextBlock.lane-name">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    </Style>
    <Style Selector="Border.lane.muted TextBlock.lane-name">
      <Setter Property="Foreground" Value="{StaticResource Muted3Brush}" />
    </Style>
    <Style Selector="TextBlock.lane-sub">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource Muted2Brush}" />
    </Style>
    <Style Selector="Button.mute">
      <Setter Property="Foreground" Value="{StaticResource Text4Brush}" />
    </Style>
    <Style Selector="Border.lane.muted Button.mute">
      <Setter Property="Foreground" Value="{StaticResource Muted3Brush}" />
    </Style>
    <Style Selector="Button.mute:pointerover">
      <Setter Property="Background" Value="#333333" />
    </Style>
  </UserControl.Styles>
</UserControl>
