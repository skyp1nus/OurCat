<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OurCut.App.ViewModels"
             xmlns:c="using:OurCut.App.Controls"
             x:Class="OurCut.App.Views.TitleBar"
             x:DataType="vm:EditorViewModel">
  <!-- 44 px bar + 1 px bottom border. Empty areas drag the window. -->
  <Border Name="Bar" Height="45" Background="{StaticResource ChromeBrush}"
          BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
          WindowDecorationProperties.ElementRole="TitleBar">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
        <!-- Logo -->
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="18" Height="18" CornerRadius="4" Background="{StaticResource AccentBrush}">
            <Border Width="2" Height="12" CornerRadius="1" Background="#202020">
              <Border.RenderTransform>
                <RotateTransform Angle="18" />
              </Border.RenderTransform>
            </Border>
          </Border>
          <TextBlock Text="OurCut" FontSize="13" FontWeight="SemiBold" LetterSpacing="-0.13"
                     Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Menus -->
        <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center"
                    WindowDecorationProperties.ElementRole="User">
          <Button Classes="menu" Content="File">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Open video…" InputGesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
                <MenuItem Header="Open project…" IsEnabled="False" />
                <MenuItem Header="Save project" InputGesture="Ctrl+S" IsEnabled="False" />
                <MenuItem Header="Save project as…" InputGesture="Ctrl+Shift+S" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Export…" InputGesture="Ctrl+E" Command="{Binding Export.OpenCommand}" IsEnabled="{Binding HasFile}" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExit" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="menu" Content="Edit">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Undo" InputGesture="Ctrl+Z" IsEnabled="False" />
                <MenuItem Header="Redo" InputGesture="Ctrl+Y" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Set in-point" InputGesture="I" Command="{Binding MarkInCommand}" />
                <MenuItem Header="Set out-point" InputGesture="O" Command="{Binding MarkOutCommand}" />
                <MenuItem Header="Split at playhead" InputGesture="S" Command="{Binding SplitCommand}" />
                <MenuItem Header="Exclude / keep clip" InputGesture="E" Command="{Binding ToggleExcludeCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="menu" Content="View">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Zoom in" Command="{Binding ZoomInCommand}" />
                <MenuItem Header="Zoom out" Command="{Binding ZoomOutCommand}" />
                <Separator />
                <MenuItem Header="Claude panel" Command="{Binding Claude.ToggleOpenCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="menu" Content="Help">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Keyboard shortcuts" IsEnabled="False" />
                <MenuItem Header="About OurCut" IsEnabled="False" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <Border Width="1" Height="18" Background="#3C3C3C" VerticalAlignment="Center" />

        <Button Classes="control" Padding="9,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Open file (Ctrl+O)"
                Command="{Binding OpenFileCommand}" WindowDecorationProperties.ElementRole="User">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <c:SvgIcon Data="{StaticResource IconFolder}" StrokeWidth="1.8" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="Open" VerticalAlignment="Center" />
            <Border Classes="kbd"><TextBlock Text="Ctrl+O" /></Border>
          </StackPanel>
        </Button>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding HasFile}">
          <TextBlock Text="{Binding ProjectName}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Classes="mono" Text="{Binding MediaInfo}" FontSize="11" Foreground="{StaticResource Muted2Brush}"
                     VerticalAlignment="Center" Margin="0,1,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}">
          <TextBlock Text="Untitled project" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource Text4Brush}"
                     VerticalAlignment="Center" />
          <TextBlock Classes="mono" Text="no media" FontSize="11" Foreground="{StaticResource Muted4Brush}"
                     VerticalAlignment="Center" Margin="0,1,0,0" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
        <!-- Claude is editing -->
        <Border IsVisible="{Binding IsClaudeBusy}" Height="24" Padding="10,0" CornerRadius="12" Background="#24AA9CF7"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <c:PulseDot Width="7" Height="7" Fill="{StaticResource VioletBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Claude is editing" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource VioletTextBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <Button Classes="ghost bright" Width="28" Height="28" VerticalAlignment="Center" Foreground="{StaticResource Text4Brush}"
                ToolTip.Tip="Settings" WindowDecorationProperties.ElementRole="User">
          <c:SvgIcon Data="{StaticResource IconSettings}" StrokeWidth="1.8" Width="15" Height="15" />
        </Button>

        <Button Classes="primary" Height="28" Padding="11,0" VerticalAlignment="Center" ToolTip.Tip="Export (Ctrl+E)"
                IsEnabled="{Binding HasFile}" Command="{Binding Export.OpenCommand}" WindowDecorationProperties.ElementRole="User">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <c:SvgIcon Data="{StaticResource IconExport}" StrokeWidth="2" Width="14" Height="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ExportButtonText}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Export.PercentText}" VerticalAlignment="Center" IsVisible="{Binding Export.IsExporting}" />
            <TextBlock Classes="mono" Text="Ctrl+E" FontSize="10" FontWeight="Medium" Opacity="0.55" VerticalAlignment="Center"
                       IsVisible="{Binding HasFile}" />
          </StackPanel>
        </Button>

        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
          <Button Classes="caption" Click="OnMinimize" WindowDecorationProperties.ElementRole="MinimizeButton">
            <c:SvgIcon Data="{StaticResource IconMinimize}" ViewBox="10" StrokeWidth="1" LineCap="Flat" Width="10" Height="10" />
          </Button>
          <Button Classes="caption" Click="OnMaximize" WindowDecorationProperties.ElementRole="MaximizeButton">
            <c:SvgIcon Data="{StaticResource IconMaximize}" ViewBox="10" StrokeWidth="1" LineCap="Flat" Width="10" Height="10" />
          </Button>
          <Button Classes="caption close" Click="OnClose" WindowDecorationProperties.ElementRole="CloseButton">
            <c:SvgIcon Data="{StaticResource IconCloseWindow}" ViewBox="10" StrokeWidth="1" LineCap="Flat" Width="10" Height="10" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
