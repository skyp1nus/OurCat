<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colours and fonts from design/project/OurCutEditor v2.dc.html. -->

  <FontFamily x:Key="SansFont">fonts:OurCut#Geist</FontFamily>
  <FontFamily x:Key="MonoFont">fonts:OurCut#Geist Mono</FontFamily>

  <!-- Accent (selection, export) and violet (changes made by Claude). -->
  <Color x:Key="AccentColor">#60CDFF</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#7AD6FF" />
  <SolidColorBrush x:Key="VioletBrush" Color="#AA9CF7" />
  <SolidColorBrush x:Key="VioletTextBrush" Color="#D0C9FF" />
  <SolidColorBrush x:Key="StatusOnBrush" Color="#6FD087" />
  <SolidColorBrush x:Key="StatusOffBrush" Color="#EF6661" />

  <!-- Surfaces. -->
  <SolidColorBrush x:Key="WindowBrush" Color="#1C1C1C" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#202020" />
  <SolidColorBrush x:Key="VideoAreaBrush" Color="#171717" />
  <SolidColorBrush x:Key="PanelBrush" Color="#1F1F1F" />
  <SolidColorBrush x:Key="DialogBrush" Color="#2B2B2B" />
  <SolidColorBrush x:Key="ControlBrush" Color="#2D2D2D" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />

  <!-- Lines. -->
  <SolidColorBrush x:Key="DividerBrush" Color="#2E2E2E" />
  <SolidColorBrush x:Key="DividerSoftBrush" Color="#2D2D2D" />
  <SolidColorBrush x:Key="OutlineBrush" Color="#3A3A3A" />
  <SolidColorBrush x:Key="OutlineStrongBrush" Color="#404040" />
  <SolidColorBrush x:Key="KbdBorderBrush" Color="#484848" />

  <!-- Text. -->
  <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Text2Brush" Color="#E2E2E2" />
  <SolidColorBrush x:Key="Text3Brush" Color="#D6D6D6" />
  <SolidColorBrush x:Key="Text4Brush" Color="#C5C5C5" />
  <SolidColorBrush x:Key="MutedBrush" Color="#A6A6A6" />
  <SolidColorBrush x:Key="Muted2Brush" Color="#8A8A8A" />
  <SolidColorBrush x:Key="Muted3Brush" Color="#6E6E6E" />
  <SolidColorBrush x:Key="Muted4Brush" Color="#686868" />
</ResourceDictionary>
