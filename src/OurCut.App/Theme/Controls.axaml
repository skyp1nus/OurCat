<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OurCut.App.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OurCut/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://OurCut/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- A bare button: every look below is a style class on top of it. -->
      <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- Square checkbox: 16 px in the clip list, 15 px (class "small") in dialogs. -->
      <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <ControlTemplate>
            <StackPanel Orientation="Horizontal" Spacing="9" Background="Transparent">
              <Border Name="box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                      BorderBrush="#5C5C5C" Background="Transparent" VerticalAlignment="Center">
                <c:SvgIcon Name="tick" Data="{StaticResource IconCheck}" StrokeWidth="3.5"
                           Width="10" Height="10" Foreground="#000000" IsVisible="False" />
              </Border>
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                VerticalAlignment="Center" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Border#box">
          <Setter Property="Background" Value="{StaticResource AccentBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ c|SvgIcon#tick">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.small /template/ Border#box">
          <Setter Property="Width" Value="15" />
          <Setter Property="Height" Value="15" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.4" />
          <Setter Property="Cursor" Value="Arrow" />
        </Style>
      </ControlTheme>

      <!-- Chrome-style range input from the timeline toolbar (accent-color #60CDFF). -->
      <ControlTheme x:Key="ZoomSlider" TargetType="Slider">
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid>
              <Border Height="8" CornerRadius="4" Background="#3B3B3B" BorderBrush="#858585" BorderThickness="1"
                      VerticalAlignment="Center" Margin="0" />
              <Track Name="PART_Track" Orientation="Horizontal"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Height="8" Margin="0,0,-8,0" CornerRadius="4,0,0,4" Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="16" Height="16">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Ellipse Width="16" Height="16" Fill="{StaticResource AccentBrush}" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>

      <!-- Volume: 3 px track, light fill, 10 px white knob. -->
      <ControlTheme x:Key="VolumeSlider" TargetType="Slider">
        <Setter Property="Height" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid>
              <Border Height="3" CornerRadius="2" Background="#404040" VerticalAlignment="Center" />
              <!-- The knob is centred on the value (CSS left: n%), so the track overhangs by half a knob. -->
              <Track Name="PART_Track" Orientation="Horizontal" Margin="-5,0"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value, Mode=TwoWay}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_DecreaseButton" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Height="3" Margin="5,0,-5,0" CornerRadius="2" Background="#C5C5C5" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_IncreaseButton" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate>
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseButton>
                <Thumb Name="thumb" Width="10" Height="10">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Ellipse Width="10" Height="10" Fill="#FFFFFF" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Text defaults. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <!-- Keyboard hint chip, e.g. "Ctrl+O". -->
  <Style Selector="Border.kbd">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="{StaticResource KbdBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="#262626" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd.plain">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.kbd.small">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Border.kbd.status">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <!-- Title bar menu items (File, Edit, …). -->
  <Style Selector="Button.menu">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="#D0D0D0" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.menu:pointerover">
    <Setter Property="Background" Value="{StaticResource SubtleHoverBrush}" />
  </Style>

  <!-- Filled grey button with border (Open, Browse…). -->
  <Style Selector="Button.control">
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OutlineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.control:pointerover">
    <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
  </Style>

  <!-- Transparent button with a thin outline (Set in, Split, 1×…). -->
  <Style Selector="Button.outline">
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
  </Style>
  <Style Selector="Button.outline.strong">
    <Setter Property="BorderBrush" Value="{StaticResource OutlineStrongBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.outline:pointerover">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
  </Style>

  <!-- Icon-only ghost button. -->
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
  </Style>
  <Style Selector="Button.ghost.bright:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Accent button (Export). -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Background" Value="{StaticResource ControlBrush}" />
    <Setter Property="Foreground" Value="#646464" />
    <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- White button (Open file…, play). -->
  <Style Selector="Button.white">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#1C1C1C" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Window caption buttons. -->
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="#D0D0D0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.caption:pointerover">
    <Setter Property="Background" Value="{StaticResource SubtleHoverBrush}" />
  </Style>
  <Style Selector="Button.caption.close:pointerover">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Thin scrollbars (#484848 thumb). -->
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="#484848" />
  </Style>

  <!-- Text input without chrome (Claude composer). -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="PlaceholderForeground" Value="{StaticResource Muted2Brush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
