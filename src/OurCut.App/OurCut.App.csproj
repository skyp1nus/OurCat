<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OurCut.App</RootNamespace>
    <AssemblyName>OurCut</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ourcut.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OurCut.Core\OurCut.Core.csproj" />
    <ProjectReference Include="..\OurCut.Media\OurCut.Media.csproj" />
    <ProjectReference Include="..\OurCut.Mcp\OurCut.Mcp.csproj" />
    <ProjectReference Include="..\OurCut.Transcription\OurCut.Transcription.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OurCut.App.Tests" />
  </ItemGroup>
  <Import Project="..\..\build\OurCut.NativeDeps.targets" />

  <!-- Release builds: SkiaSharp and HarfBuzz ship ~100 MB of native debug symbols that users do not need. -->
  <Target Name="OurCutDropNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' and ('%(Filename)' == 'libSkiaSharp' or '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>
</Project>
